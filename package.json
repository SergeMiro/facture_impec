{
  "name": "facture-impec",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:addin": "turbo run dev --filter=@fi/addin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test",
    "test:oracle": "turbo run test:oracle",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "boundaries": "tsx scripts/boundaries/check.ts",
    "test:scripts": "vitest run --dir scripts",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && turbo run test test:oracle && pnpm test:scripts",
    "scenario": "tsx scripts/run-scenario.ts",
    "load": "tsx scripts/load/run.ts",
    "load:sync": "tsx scripts/load/sync.ts",
    "perf": "tsx scripts/perf/run.ts",
    "org": "tsx scripts/org/run.ts",
    "accounting:check": "tsx scripts/accounting/check.ts",
    "vault:demo": "tsx scripts/vault-demo.ts",
    "runner:restore": "tsx apps/api/scripts/runner-restore.ts",
    "test:e2e": "pnpm --filter @fi/addin test:e2e",
    "seed:demo": "pnpm --filter @fi/addin seed:demo",
    "addin:icons": "pnpm --filter @fi/addin icons",
    "appsource:package": "pnpm --filter @fi/addin appsource",
    "sheets:package": "pnpm --filter @fi/addin sheets"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fi/api": "workspace:*",
    "@fi/core": "workspace:*",
    "@fi/memory": "workspace:*",
    "@fi/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
