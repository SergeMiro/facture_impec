{
  "name": "facture-impec",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:addin": "turbo run dev --filter=@fi/addin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "test": "turbo run test",
    "test:oracle": "turbo run test:oracle",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && turbo run test test:oracle",
    "scenario": "tsx scripts/run-scenario.ts",
    "test:e2e": "pnpm --filter @fi/addin test:e2e",
    "seed:demo": "pnpm --filter @fi/addin seed:demo",
    "addin:icons": "tsx scripts/addin-icons.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fi/api": "workspace:*",
    "@fi/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
