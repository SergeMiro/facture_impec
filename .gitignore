# ── Node / pnpm / Turborepo ────────────────────────────────────
node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# ── Secrets / env (never commit) ───────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Editors / OS ───────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
*~

# Oracle files fetched by `pnpm --filter @fi/core oracle:fetch` and compiled SEF (packages/core)
.oracle-cache/

# Astro / Vercel build output (apps/site)
.astro
.vercel

# Local PGlite database (PGLITE_DIR, apps/api)
.data/

# Playwright output (apps/addin E2E)
test-results/
playwright-report/
# Microsoft sign-in recorded for the Excel-on-the-web E2E
apps/addin/e2e/.auth/

# Alertmanager with the operator's addresses (deploy/observability/alertmanager.example.yml)
deploy/observability/alertmanager.yml
