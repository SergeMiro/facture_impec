---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={`${title} — Facture Impec`} description={description} navLight>
  <article class="container-page max-w-3xl pt-32 pb-24">
    <p class="eyebrow">Informations</p>
    <h1 class="mt-4 text-4xl font-medium text-leaf-950 sm:text-5xl">{title}</h1>
    <p class="mt-3 text-sm text-muted">Dernière mise à jour : {updated}</p>
    <div class="legal mt-10 space-y-8 leading-relaxed text-ink/85">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
  .legal h2 {
    font-size: 1.5rem;
    color: var(--color-leaf-950);
    margin-bottom: 0.6rem;
  }
  .legal p + p,
  .legal ul {
    margin-top: 0.6rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal li + li {
    margin-top: 0.35rem;
  }
  .legal a {
    color: var(--color-leaf-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
