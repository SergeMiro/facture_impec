---
import { offer, trialDays, trialRealSends } from '../../content/site';
import { Icon } from '../Icon';

const price = new Intl.NumberFormat('fr-FR', { minimumFractionDigits: 2 }).format(offer.price);
---

<section id="tarifs" class="relative py-20 sm:py-28">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center">Tarif</p>
      <h2 class="mt-4 text-4xl font-medium text-leaf-950 sm:text-5xl">Un seul prix. Sans surprise.</h2>
      <p class="mt-5 text-lg text-muted">
        {trialDays} jours d’essai gratuit, sans carte bancaire. Ensuite, un abonnement simple, sans
        engagement.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-4xl overflow-hidden rounded-[1.75rem] bg-leaf-950 text-white shadow-[0_30px_60px_-25px_rgb(5_36_26/0.7)] ring-1 ring-leaf-400/30 md:grid md:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col justify-between gap-8 p-8 sm:p-10">
        <div>
          <h3 class="text-2xl text-white">{offer.name}</h3>
          <p class="mt-1.5 text-sm text-leaf-100/70">{offer.pitch}</p>
          <p class="mt-8 flex items-baseline gap-2">
            <span class="font-display text-6xl font-medium tabular-nums text-white">{price} €</span>
            <span class="text-sm text-leaf-100/70">HT {offer.unit}</span>
          </p>
          <p class="mt-2 text-sm text-leaf-200/80">Sans engagement · résiliable en un clic</p>
          <p class="mt-6 rounded-xl bg-white/8 px-3.5 py-2.5 text-sm font-medium text-leaf-100">
            Mode test illimité · {trialRealSends} envois réels pendant l’essai
          </p>
        </div>
        <a href="#essai" class="btn btn-primary w-full">
          {offer.cta} <Icon name="arrowRight" size={17} />
        </a>
      </div>
      <ul class="space-y-3.5 border-t border-white/10 bg-white/[0.03] p-8 text-[0.95rem] sm:p-10 md:border-t-0 md:border-l">
        {
          offer.features.map((f) => (
            <li class="flex gap-3">
              <Icon name="check" size={18} className="mt-0.5 shrink-0 text-leaf-300" />
              <span class="text-leaf-50/85">{f}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-center text-sm text-muted">
      Prix hors taxes. Vos données restent exportables à tout moment.
    </p>
  </div>
</section>
