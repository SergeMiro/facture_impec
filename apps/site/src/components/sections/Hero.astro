---
import { demoFilm } from '../../content/demo-film';
import { deadlines, trialDays } from '../../content/site';
import { Icon } from '../Icon';
import AutoDemoVideo from '../islands/AutoDemoVideo';
---

<section class="site-hero relative isolate overflow-hidden bg-leaf-950 pt-22 pb-20 text-white sm:pt-36 sm:pb-28">
  <div class="grain absolute inset-0 -z-10 opacity-70"></div>
  <div
    class="absolute inset-0 -z-20"
    style="background: radial-gradient(60rem 40rem at 85% -10%, rgb(71 181 130 / 0.35), transparent 60%), radial-gradient(50rem 30rem at -10% 110%, rgb(201 168 91 / 0.16), transparent 60%), linear-gradient(180deg, #05241a, #082f22);"
  >
  </div>
  <svg class="absolute inset-0 -z-10 h-full w-full opacity-[0.07]" aria-hidden="true">
    <defs>
      <pattern id="hero-grid" width="44" height="44" patternUnits="userSpaceOnUse">
        <path d="M44 0H0v44" fill="none" stroke="white" stroke-width="1"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)"></rect>
  </svg>

  <div class="hero-layout container-page grid items-center gap-7 sm:gap-12 lg:grid-cols-[0.78fr_1.22fr]">
    <div class="hero-copy animate-rise">
      <a
        href="#reforme"
        class="hero-deadline hidden sm:inline-flex items-center gap-2 rounded-full bg-white/8 py-1.5 pr-3 pl-1.5 text-xs font-medium text-leaf-100 ring-1 ring-white/15 transition hover:bg-white/12"
      >
        <span class="rounded-full bg-gold/90 px-2 py-0.5 text-[0.7rem] font-semibold text-leaf-950">Réforme</span>
        TPE / PME · {deadlines.emission.label}
        <span class="countdown hidden font-semibold text-white sm:inline" data-target={deadlines.emission.date}></span>
      </a>
      <p class="hero-kicker">Votre tableur. Votre nouvel assistant.</p>
      <h1 class="mt-2 text-[2.05rem] leading-[1.05] font-medium sm:mt-6 sm:text-6xl lg:text-[3.55rem]">
        {demoFilm.heroTitle} <span class="italic text-leaf-300">{demoFilm.heroEmphasis}</span>
      </h1>
      <p class="mt-6 hidden max-w-xl text-lg leading-relaxed text-leaf-50/80 sm:block">
        {demoFilm.heroDescription}
      </p>
      <p class="mt-4 text-sm leading-relaxed text-leaf-50/80 sm:hidden">{demoFilm.heroMobileDescription}</p>
      <div class="hero-actions mt-9 hidden gap-3 sm:flex sm:flex-row">
        <a href="#essai" class="btn btn-primary !px-6 !py-3.5 text-base">
          Essai gratuit {trialDays} jours <Icon name="arrowRight" size={18} />
        </a>
        <a href="#demo" class="btn btn-ghost-light !px-6 !py-3.5 text-base">
          <Icon name="play" size={16} /> Essayer la démo
        </a>
      </div>
      <ul class="mt-9 hidden flex-wrap gap-x-6 sm:flex gap-y-2 text-sm text-leaf-100/75">
        <li class="flex items-center gap-2"><Icon name="check" size={16} className="text-leaf-300" /> Sans carte bancaire</li>
        <li class="flex items-center gap-2"><Icon name="check" size={16} className="text-leaf-300" /> Excel et Google Sheets</li>
        <li class="flex items-center gap-2"><Icon name="check" size={16} className="text-leaf-300" /> Données hébergées en UE</li>
      </ul>
    </div>

    <div class="hero-player relative min-w-0">
      <div class="absolute -inset-6 -z-10 rounded-[2rem] bg-leaf-400/20 blur-3xl"></div>
      <AutoDemoVideo client:load />
    </div>
    <a href="#essai" class="btn btn-primary w-full sm:hidden">Essai gratuit {trialDays} jours <Icon name="arrowRight" size={18} /></a>
  </div>
</section>

<script>
  const fmt = (target: string) => {
    const days = Math.ceil((new Date(`${target}T00:00:00+02:00`).getTime() - Date.now()) / 86_400_000);
    return days > 0 ? `· J-${days}` : '';
  };
  document.querySelectorAll<HTMLElement>('.countdown').forEach((el) => {
    const target = el.dataset.target;
    if (target) el.textContent = fmt(target);
  });
</script>
