# Facture Impec — every variable the code reads, with its default.
# Copy to .env at the repo root; all apps load it. Secrets stay empty here and live in Vercel / the VPS.

# local | sandbox | prod (see docs/ARCHITECTURE.md §Environments)
FI_ENV=local

# ── apps/api — Hono API ────────────────────────────────────────
API_PORT=4000
# 0.0.0.0 in a container; the default keeps a dev API off the network.
API_HOST=127.0.0.1
# Behind a reverse proxy, the header carrying the client's address (cf-connecting-ip behind
# Cloudflare, x-forwarded-for behind nginx); the request limits count per address. Empty: the socket's.
TRUST_PROXY_HEADER=

# Postgres. Empty: an embedded PGlite database in PGLITE_DIR (local only; required in sandbox/prod).
DATABASE_URL=
# Relative paths are read from the repo root.
PGLITE_DIR=.data/pglite
# The company's vault (docs/RUNBOOK.md § Runner). Set: this API is the runner, alone on the vault,
# listening on this machine only, its database in PGLITE_DIR (outside the vault, DATABASE_URL empty).
VAULT_DIR=
# The runner in a container (deploy/runner/): it listens on every interface of the container, its
# port published on the host's 127.0.0.1 only.
RUNNER_CONTAINER=false
# The runner's relay (docs/RUNBOOK.md § Relay): Telegram reaches the company's people through it.
# Empty URL: no Telegram. The licence comes from the relay's operator; the key from
# `pnpm runner:key`, kept on this machine only (never in the vault).
RELAY_URL=
RELAY_LICENCE=
RELAY_RUNNER_KEY=
# How often the runner fetches the answers waiting on the relay.
RELAY_POLL_SECONDS=15

# The relay itself (apps/relay, `pnpm relay`): its port, its admin token (≥ 24 characters), its
# database (empty URL: PGlite in RELAY_PGLITE_DIR). Telegram stays paused (docs/DECISIONS.md D3).
RELAY_PORT=4020
RELAY_ADMIN_TOKEN=
RELAY_DATABASE_URL=
RELAY_PGLITE_DIR=.data/relay
# The bot (@BotFather), the webhook's secret (16–256 of A-Z a-z 0-9 _ -), Telegram's host (tests
# put the stand-in of apps/mock-pdp/src/telegram.ts there).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_URL=https://api.telegram.org

# Bearer token for POST /admin/tenants (≥ 24 characters). Empty: admin routes answer 503.
# Required in sandbox/prod.
ADMIN_TOKEN=
# Bearer token Prometheus sends to GET /metrics (≥ 24 characters, not the admin token: it reads
# counts only). Empty: no /metrics route (docs/RUNBOOK.md § Observability).
METRICS_TOKEN=

# Run the pg-boss workers (send, sync, sweep) in the API process.
API_WORKERS=true
# How often the sweep re-queues unfinished sends and refreshes invoices still awaiting the platform.
PDP_SYNC_INTERVAL_SECONDS=300

# Public address of this API: the sign-in links e-mailed to users point here.
API_PUBLIC_URL=http://localhost:4000
# Origins allowed to call the API from a browser (the task pane), comma-separated.
ADDIN_ORIGINS=https://localhost:3000

# ── AI included in the subscription (docs/AI_PROVIDERS.md) ─────
# Empty AI_PROVIDER: no included AI, the agents fall back to the deterministic answers.
# mistral | anthropic | openai | google | azure | openai-compatible
AI_PROVIDER=
AI_MODEL_AGENT=
# Defaults to AI_MODEL_AGENT.
AI_MODEL_CLASSIFY=
# Required for azure and openai-compatible.
AI_BASE_URL=
AI_API_KEY=
# openai-compatible only: the endpoint takes a JSON schema (OpenRouter models that list structured_outputs).
AI_STRUCTURED_OUTPUTS=false
# openai-compatible only: a JSON object added to every request, e.g. for OpenRouter
# {"provider":{"zdr":true,"data_collection":"deny","require_parameters":true,"sort":"price"}}
AI_REQUEST_BODY=
# Seals the keys tenants bring (BYOK), 32 bytes in base64: `openssl rand -base64 32`.
# Empty: tenants cannot save their own key.
AI_KEY_SEALING_KEY=
# Token caps: per agent run (estimated input) and per tenant per day (Europe/Paris).
AI_RUN_TOKENS=30000
AI_DAILY_TOKENS=300000

# ── B2Brouter (docs/B2BROUTER.md, docs/RUNBOOK.md § B2Brouter) ──
# The operator API key; empty: no B2Brouter adapter. Required in sandbox, where only a sandbox
# key (test_…) is accepted. Never commit it, never paste it in a URL or a log.
# Local, against the stand-in in apps/mock-pdp: B2BROUTER_API_KEY=test_local_stand_in and
# B2BROUTER_BASE_URL=http://localhost:4010/b2brouter
B2BROUTER_API_KEY=
# Empty: B2Brouter's API host (it serves the sandbox to test_ keys). Another host only in local.
B2BROUTER_BASE_URL=
# The signing_secret B2Brouter shows once when the webhook is created; empty: webhooks refused,
# the sweep alone brings news.
B2BROUTER_WEBHOOK_SECRET=
# prod only: a sandbox key (test_…) of the same integration, where « Mode test » sends, and the
# secret of its webhook (/webhooks/pdp/b2brouter_test). Empty in prod: no Mode test.
B2BROUTER_SANDBOX_API_KEY=
B2BROUTER_SANDBOX_WEBHOOK_SECRET=
# Seals the B2Brouter keys companies bring themselves (Réglages, docs/B2BROUTER.md §12), 32 bytes
# in base64: `openssl rand -base64 32`. Empty: every company sends under the operator key.
PDP_KEY_SEALING_KEY=

# ── Mail: sign-in links, chasing e-mails, weekly report ────────
# smtps://user:password@host:465 — a secret, never commit it. Empty in local: mails kept in memory
# (GET /admin/outbox) and printed; empty elsewhere: no sign-in by link, no mail sent.
MAIL_SMTP_URL=
# Required with MAIL_SMTP_URL, e.g. Facture Impec <bonjour@example.fr>
MAIL_FROM=

# ── Company directory (docs/ONBOARDING.md) ─────────────────────
# Annuaire des entreprises (no key). Local and tests may point it at the stand-in:
# http://localhost:4010/sirene
SIRENE_URL=https://recherche-entreprises.api.gouv.fr
# VIES, the European Commission's check of EU customers' VAT numbers (no key), asked by the sweep.
# Local and tests may point it at the stand-in: http://localhost:4010/vies
VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api
# The published terms (CGU) a new account accepts. Empty: « Créer un compte » is offered only in local.
TERMS_URL=

# ── Billing (docs/BILLING.md) ──────────────────────────────────
# The owner's Stripe key: sk_test_/rk_test_ outside prod, sk_live_/rk_live_ in prod. Empty: nobody is
# billed and no send waits for a plan. Never commit it.
STRIPE_SECRET_KEY=
# whsec_… of the webhook endpoint (API version 2026-09-30.endive); required with the key.
STRIPE_WEBHOOK_SECRET=
# Empty: Stripe. Local stand-in: http://localhost:4010/stripe (only FI_ENV=local accepts another host).
STRIPE_BASE_URL=
# Checkout prices per plan and interval, comma-separated: the flat price first, then the metered one
# for invoices beyond the quota. An empty plan is not offered.
STRIPE_PRICES_ESSENTIEL_MONTH=
STRIPE_PRICES_ESSENTIEL_YEAR=
STRIPE_PRICES_CROISSANCE_MONTH=
STRIPE_PRICES_CROISSANCE_YEAR=
# The meter's event name (facture_envoyee). Empty: invoices beyond the quota are counted, not charged.
STRIPE_METER_EVENT=
# true only once the French VAT registration is added in Stripe Tax.
STRIPE_AUTOMATIC_TAX=false

# ── OneDrive / SharePoint connector (docs/MICROSOFT365.md) ─────
# The owner's app registration in Microsoft Entra (personal and work accounts). Empty: no connector.
# Local stand-in (apps/mock-pdp /microsoft): 00000000-0000-4000-8000-00000000f1f1
MICROSOFT_CLIENT_ID=
# Its client secret, for the on-behalf-of exchange. Local stand-in: local-microsoft-client-secret.
# Never commit a real one.
MICROSOFT_CLIENT_SECRET=
# Empty: login.microsoftonline.com and graph.microsoft.com/v1.0. Local stand-in:
# http://localhost:4010/microsoft and http://localhost:4010/microsoft/graph/v1.0 (local only).
MICROSOFT_LOGIN_URL=
MICROSOFT_GRAPH_URL=

# ── Google Drive connector (docs/GOOGLE.md) ─────
# The owner's OAuth client (Google Cloud console, type Web application, redirect URI
# <API_PUBLIC_URL>/connectors/google/callback). Empty: no connector.
# Local stand-in (apps/mock-pdp /google): local-google-client.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Its client secret, for the code exchange. Local stand-in: local-google-client-secret.
# Never commit a real one.
GOOGLE_CLIENT_SECRET=
# Empty: accounts.google.com, oauth2.googleapis.com and www.googleapis.com. Local stand-in:
# http://localhost:4010/google/accounts, …/google/oauth and …/google/api (local only).
GOOGLE_ACCOUNTS_URL=
GOOGLE_OAUTH_URL=
GOOGLE_API_URL=

# Seals the connected accounts' refresh tokens (OneDrive and Google Drive): 32 bytes in base64
# (openssl rand -base64 32).
CONNECTOR_SEALING_KEY=

# ── apps/mock-pdp — fake PDP used by local dev, tests and scenarios ──
MOCK_PDP_PORT=4010
# Where the API reaches the mock.
MOCK_PDP_URL=http://localhost:4010
# Where the mock pushes status webhooks. Empty: no webhooks, the sweep alone brings news.
MOCK_PDP_WEBHOOK_URL=http://localhost:4000/webhooks/pdp/mock
# Shared by the mock (signs) and the API (verifies), ≥ 16 characters.
MOCK_PDP_WEBHOOK_SECRET=local-mock-pdp-webhook-secret
# Business seconds per real second: 86400 = a day per second, the default timeline ends in ~32 s.
MOCK_PDP_SPEED=86400
# Where the mock's B2Brouter stand-in (/b2brouter) pushes its webhooks, signed with
# B2BROUTER_WEBHOOK_SECRET (else MOCK_PDP_WEBHOOK_SECRET). Empty: none, the sweep brings news.
# Local stand-in: http://localhost:4000/webhooks/pdp/b2brouter
MOCK_PDP_B2BROUTER_WEBHOOK_URL=
# Where the mock's Stripe stand-in (/stripe) posts its webhooks, and their secret (set the same value
# in STRIPE_WEBHOOK_SECRET to bill locally). Local: http://localhost:4000/webhooks/stripe
MOCK_STRIPE_WEBHOOK_URL=
MOCK_STRIPE_WEBHOOK_SECRET=whsec_local-mock-stripe-secret

# ── apps/addin — Vite dev server for the task pane ─────────────
ADDIN_PORT=3000
# Where the built task pane calls the API. The dev server proxies /api to API_PORT.
ADDIN_API_URL=/api

# apps/site — marketing site (Astro)
SITE_PORT=4321
PUBLIC_SITE_URL=https://facture-impec-site.vercel.app
# Shown on the legal pages; leave empty until the owner chooses the address.
PUBLIC_CONTACT_EMAIL=
# Trial requests are stored here (apps/site/sql/001 and 002): the project's publishable key, which may only
# call submit_trial_request. Without them, dev accepts requests and only logs them; production answers 503.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional owner notification for each trial request (no personal data is sent).
TRIAL_NOTIFY_TELEGRAM_BOT_TOKEN=
TRIAL_NOTIFY_TELEGRAM_CHAT_ID=
